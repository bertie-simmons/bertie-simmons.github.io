---
import BaseLayout from "../layouts/Layout.astro";
import AsciiHero from "../components/Hero.astro";
import About from "../components/About.astro";
import WorkExperience from "../components/WorkExperience.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import ScrollDissolve from "../components/ScrollDissolve.astro";
import NavBar from "../components/react/NavBar";
---

<BaseLayout title="Bertram Simmons">
  <!-- <NavBar client:idle /> -->

  <ScrollDissolve>
    <AsciiHero slot="top" />
    <div slot="bottom" id="about">
      <About />
    </div>
  </ScrollDissolve>

  <main>
    <section id="projects">
      <Projects />
    </section>

    <section id="work">
      <WorkExperience />
    </section>

    <section id="contact">
      <Contact />
    </section>
  </main>
</BaseLayout>
